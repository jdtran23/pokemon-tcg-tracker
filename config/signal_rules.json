{
  "rules": [
    {
      "type": "strong_buy",
      "signal": "buy",
      "condition": "price < 0.95*avg_30 AND change_7d > 0",
      "thresholds": {"dip_ratio": 0.95, "momentum_min_pct": 0}
    },
    {
      "type": "buy_dip",
      "signal": "buy",
      "condition": "price < 0.9 * avg_30",
      "thresholds": {"buy_dip_ratio": 0.9}
    },
    {
      "type": "sell_opportunity",
      "signal": "sell",
      "condition": "price > 1.2 * avg_30",
      "thresholds": {"sell_premium_ratio": 1.2}
    },
    {
      "type": "rising",
      "signal": "buy",
      "condition": "price_change_7d_pct > 5",
      "thresholds": {"rising_min_pct": 5}
    },
    {
      "type": "declining",
      "signal": "sell",
      "condition": "price_change_30d_pct < -10",
      "thresholds": {"declining_max_pct": -10}
    },
    {
      "type": "weak_sell",
      "signal": "sell",
      "condition": "price_change_30d_pct < -5",
      "thresholds": {"weak_sell_max_pct": -5}
    },
    {
      "type": "hold_accumulate",
      "signal": "hold",
      "condition": "trend=stable AND price near avg_30",
      "thresholds": {"near_low": 0.95, "near_high": 1.05}
    },
    {
      "type": "dip_vs_avg7",
      "signal": "buy",
      "condition": "price < 0.95 * avg_7",
      "thresholds": {"dip_avg7_ratio": 0.95}
    },
    {
      "type": "below_direct_low",
      "signal": "buy",
      "condition": "market <= direct_low (rare but good deal)",
      "thresholds": {}
    }
  ],
  "default_signal": "hold",
  "default_signal_type": "hold"
}
